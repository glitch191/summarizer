{
  "manifest_version": 3,
  "name": "Summarizer",
  "version": "0.2.0",
  "description": "Adds a Summarize entry to the context menu of pages and links. It opens Gemini and sends the address, preceded by your instruction for YouTube videos.",
  "icons": {
    "16": "icons/summarize.svg",
    "32": "icons/summarize.svg",
    "48": "icons/summarize.svg",
    "96": "icons/summarize.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{17587a7f-f6bb-4646-af6d-5e82ec378dfc}",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["contextMenus", "storage", "clipboardWrite", "activeTab", "scripting"],
  "host_permissions": ["https://gemini.google.com/*"],
  "background": {
    "scripts": ["src/background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["src/content/selectors.js", "src/content/gemini.js"],
      "run_at": "document_idle"
    }
  ],
  "sidebar_action": {
    "default_title": "Summarizer",
    "default_panel": "src/sidebar/sidebar.html",
    "default_icon": "icons/summarize.svg",
    "open_at_install": false
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  }
}
